# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sterling_vance?schema=public"

# First admin account, created once by `npm run prisma:seed` (see
# prisma/seed.ts). SEED_ADMIN_EMAIL is required — the seed script refuses
# to run without it rather than guessing a login. SEED_ADMIN_PASSWORD is
# optional: leave it blank and the script generates a random one-time
# password and prints it to the console once (not stored anywhere else,
# so copy it immediately). Either way, change the password from
# Admin -> Security right after your first login. Re-running the seed
# script against a database that already has this email does nothing —
# it will never overwrite an existing password.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
# This is an internal admin-only tool, not a consumer app — a 15m access
# token forced a silent-refresh round trip (see middleware.ts's
# maybeRefreshSession) on almost every request, and any request that landed
# more than ~15m after the last one (an admin reading a long document, on a
# call, etc.) hit that token already-expired instead of "expiring soon",
# which the refresh flow can't recover from within the SAME request — see
# apiWrite()'s comment in lib/admin-actions.ts. 12h comfortably covers a
# workday without reducing security meaningfully for this use case; the
# refresh token (below) is what actually bounds how long a stolen cookie
# stays valid.
JWT_EXPIRES_IN="12h"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"

# App
PORT=4000
# IMPORTANT (production): set this to the real deployed frontend origin
# (e.g. "https://www.efcauditing.com"), never left at the localhost
# default and never "*" — CORS is sent with credentials: true, so a
# wildcard origin would let any website make authenticated requests
# using an admin's cookies.
CORS_ORIGIN="http://localhost:3000"

# Storage (S3 / Azure Blob) — wire up in src/media/media.service.ts
STORAGE_PROVIDER="s3"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email (SMTP or Resend) — powers the OTP verification emails for
# Admin → Security → Change Password / Change Email / Forgot Password,
# plus the "Send test email" button.
#
# PREFERRED: configure this from Admin → Email Settings in the dashboard
# instead — it's stored in the database and editable without redeploying,
# and takes priority over everything below if set. These env vars are
# only the fallback for a fresh install before anyone's opened that
# screen yet (or if you'd rather manage it outside the dashboard).
# Without either configured, OTP emails show a clear "not configured"
# error instead of hanging or failing silently — everything else in the
# app works fine without this.
#
# SMTP: any standard provider works (SendGrid, Postmark, AWS SES, Mailgun,
# or a Gmail account with a 16-character "App Password" for local testing).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="EFC <no-reply@efc.ae>"
SMTP_FROM_NAME="EFC"

# Resend: alternative to SMTP — https://resend.com. If both this and SMTP_*
# are set, Admin → Email Settings' saved "provider" choice decides which is
# actually used once something's been saved there; before that, SMTP wins.
RESEND_API_KEY=""

# Cloudinary — every image/video an admin uploads (services, team photos,
# hero media, etc.) goes through Cloudinary; the frontend's Server Actions
# call this API's POST /media/cloudinary-signature to get a short-lived
# signed-upload payload, so the actual API secret only ever needs to live
# here, never in the frontend project.
#
# PREFERRED: configure this from Admin → Cloudinary Settings in the
# dashboard instead (stored in the database, editable without
# redeploying, and takes priority if set). These are only the fallback
# for a fresh install before that screen's been used.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis (session/cache — see README "Not yet built")
REDIS_URL="redis://localhost:6379"

# Elasticsearch ("Find an Expert" / site search — see README "Not yet built")
ELASTICSEARCH_NODE="http://localhost:9200"

# Google Cloud Translation API — powers the "Auto-translate" button in the
# admin dashboard (Insights, Services, Team, Testimonials edit screens).
# Without this set, those buttons will show an error but nothing else
# breaks — admins can still translate everything by hand as before.
#
# How to get a key:
#   1. https://console.cloud.google.com/ → create or select a project.
#   2. APIs & Services → Library → enable "Cloud Translation API".
#   3. APIs & Services → Credentials → Create Credentials → API key.
#   4. (Recommended) Restrict the key to the Cloud Translation API only,
#      under the key's "API restrictions".
#   5. Paste it below. Google's free tier covers the first 500,000
#      characters/month; usage past that is billed per Google's pricing.
#
# Optional now — this is only a fallback. The key is normally set from
# Admin → Translate Settings in the dashboard instead (stored in the
# database, editable without redeploying); that admin-set value always
# wins when both are present. Leave this here only for a fresh deployment
# before anyone has opened that settings screen yet.
GOOGLE_TRANSLATE_API_KEY=""
